TECHNOCORE_BASE_URL=https://technocore.chat
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TECHNOQUEUE_DEFAULT_WORKSPACE=demo
TECHNOQUEUE_LEASE_SECONDS=120
# Local runner jobs fail closed if no signed receipt arrives before this lease expires.
TECHNOQUEUE_RUNNER_JOB_LEASE_SECONDS=180
# Encrypted source snapshots are purged after this many hours if they were not consumed sooner.
TECHNOQUEUE_RUNNER_SNAPSHOT_TTL_HOURS=24
TECHNOQUEUE_DB_PATH=.data/technoqueue.sqlite
# Required in production: 32 random bytes encoded as base64.
TECHNOQUEUE_MASTER_KEY=
TECHNOQUEUE_BACKGROUND_RUNTIME=true
TECHNOQUEUE_RUNTIME_INTERVAL_MS=5000
# Optional public activity relay. The canonical technoqueue.fun deployment enables it automatically.
TECHNOQUEUE_PUBLIC_FEED=false
TECHNOQUEUE_PUBLIC_FEED_ROOM=d-technoqueue
TECHNOQUEUE_MAX_WORKSPACES_PER_USER=10
TECHNOQUEUE_MAX_PROVIDERS_PER_USER=12
TECHNOQUEUE_MAX_AGENTS_PER_WORKSPACE=24
OPENAI_API_KEY=
TECHNOQUEUE_MODEL=gpt-5
