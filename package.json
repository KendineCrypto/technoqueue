{
  "name": "technoqueue",
  "version": "0.3.3",
  "private": true,
  "description": "Agent work, coordinated through Technocore.",
  "license": "MIT",
  "homepage": "https://technoqueue.fun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KendineCrypto/technoqueue.git"
  },
  "bugs": {
    "url": "https://github.com/KendineCrypto/technoqueue/issues"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm --filter @technoqueue/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @technoqueue/core test && pnpm --filter @technoqueue/web test:runner && pnpm --filter @technoqueue/runner test",
    "agent": "pnpm --filter @technoqueue/agent start",
    "runner": "pnpm --filter @technoqueue/runner start"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
